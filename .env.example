# ============================================================
# Juweirat – Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=votre_mot_de_passe_securise

# JWT Secret (minimum 32 caractères)
# Générer avec : openssl rand -base64 48
JWT_SECRET=votre_cle_jwt_secrete_longue_et_aleatoire

# OpenAI (pour l'agent Calixia)
OPENAI_API_KEY=sk-proj-...

# Revalidation webhook Next.js
REVALIDATE_SECRET=juweirat-revalidate-2025
