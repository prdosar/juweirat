# Connexion Postgres — user READ-ONLY dédié.
# Créer via scripts/create_mcp_ro_user.sql (à la racine de juweirat-mcp).
MCP_PG_HOST=localhost
MCP_PG_PORT=5432
MCP_PG_DATABASE=juweirat
MCP_PG_USER=juweirat_mcp_ro
MCP_PG_PASSWORD=change_me

# Timeouts requête (ms) — évite qu'un LLM lâché ne tire une requête infinie.
MCP_QUERY_TIMEOUT_MS=5000

# Nombre max de lignes retournées par tool (protection contexte LLM).
MCP_MAX_ROWS=200
