# ── OpenAI ───────────────────────────────────────────────────────────────────
# Même clé que celle utilisée par l'agent sur juweirat.com (site public).
OPENAI_API_KEY=sk-proj-...

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=3010

# ── JWT (mêmes valeurs que juweirat-api pour valider les tokens admin) ───────
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=juweirat-api
JWT_AUDIENCE=juweirat-clients

# ── Postgres (chat_sessions, chat_messages, mcp_audit_log) ───────────────────
AGENT_PG_HOST=127.0.0.1
AGENT_PG_PORT=5432
AGENT_PG_DATABASE=juweirat
AGENT_PG_USER=juweirat
AGENT_PG_PASSWORD=juweirat_dev_2026

# ── MCP subprocess ───────────────────────────────────────────────────────────
# Chemin absolu vers dist/index.js de juweirat-mcp (dans le monorepo).
MCP_SERVER_ENTRY=../juweirat-mcp/dist/index.js
# Variables à propager au subprocess MCP (le user RO Postgres est différent
# du user "juweirat" utilisé pour l'agent).
MCP_PG_HOST=127.0.0.1
MCP_PG_PORT=5432
MCP_PG_DATABASE=juweirat
MCP_PG_USER=juweirat_mcp_ro
MCP_PG_PASSWORD=change_me

# ── Modèle & budgets ─────────────────────────────────────────────────────────
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_TOKENS=4096
AGENT_MAX_TOOL_ITERATIONS=8
